# Admin Panel Environment Variables

# API
NEXT_PUBLIC_API_URL=https://api.brom-casino.com
API_SECRET_KEY=your_admin_secret_key_here

# Auth
NEXTAUTH_URL=https://admin.brom-casino.com
NEXTAUTH_SECRET=your_nextauth_secret_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/brom_casino

# Redis
REDIS_URL=redis://localhost:6379

# TON
TON_API_KEY=your_tonapi_key_here
TON_NETWORK=mainnet
HOT_WALLET_ADDRESS=your_hot_wallet_address

# App
NEXT_PUBLIC_APP_NAME=BROM Casino Admin
NEXT_PUBLIC_APP_VERSION=1.0.0
