# ============================================
# Brom Casino — Environment Configuration
# Copy to .env and fill in values
# ============================================

# ===== Database =====
DATABASE_URL="postgresql://brom:***@localhost:5432/brom_casino?schema=public"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ===== JWT =====
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ===== App =====
NODE_ENV="development"
API_PORT=4000
API_URL="http://localhost:4000"
WS_URL="ws://localhost:4000"
WEB_URL="http://localhost:3000"

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""

# ===== Pragmatic Play =====
# Get credentials from: https://pragmaticplay.net/en/integrations/api/
PRAGMATIC_PLAY_API_URL="https://api.pragmaticplay.net"
PRAGMATIC_PLAY_API_KEY=""
PRAGMATIC_PLAY_CASINO_NAME=""
PRAGMATIC_PLAY_SECRET_KEY=""
PRAGMATIC_PLAY_MODE="hybrid"
# Modes: real | demo | hybrid (hybrid tries real, falls back to demo)

# ===== Cryptomus =====
# Get credentials from: https://cryptomus.com/
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_BASE_URL="https://api.cryptomus.com/v1"
CRYPTOMUS_MODE="hybrid"
# Modes: real | demo | hybrid

# ===== NOWPayments =====
# Get credentials from: https://nowpayments.io/
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# ===== Sumsub KYC =====
# Get credentials from: https://sumsub.com/
SUMSUB_API_TOKEN=""
SUMSUB_APP_TOKEN=""
SUMSUB_WEBHOOK_SECRET=""
SUMSUB_BASE_URL="https://api.sumsub.com"

# ===== Monitoring (optional) =====
SENTRY_DSN=""
