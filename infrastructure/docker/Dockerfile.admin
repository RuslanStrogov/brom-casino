FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

RUN corepack enable && corepack prepare pnpm@11 --activate

COPY . .

RUN pnpm install --frozen-lockfile

# Build Admin
RUN pnpm --filter brom-casino-admin build

# --- Production ---
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11 --activate

COPY --from=builder /app/apps/admin/.next ./.next
COPY --from=builder /app/apps/admin/package.json ./

COPY --from=builder /app/apps/admin/next.config.js ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3001

CMD ["node", "/app/node_modules/.pnpm/node_modules/next/dist/bin/next", "start"]
