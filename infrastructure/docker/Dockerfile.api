FROM node:22-alpine AS builder

WORKDIR /app

# Copy root configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11 --activate

# Copy source
COPY . .

# Install deps (with approved builds)
RUN pnpm install --frozen-lockfile

# Build API
RUN pnpm --filter @brom-casino/api build

# --- Production ---
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11 --activate

COPY --from=builder /app/services/api/dist ./dist
COPY --from=builder /app/services/api/package.json ./
COPY --from=builder /app/services/api/prisma ./prisma

# Copy workspace packages (TypeScript source, imported at runtime by compiled code)
COPY --from=builder /app/packages ./packages

# Copy root node_modules (contains .pnpm virtual store)
COPY --from=builder /app/node_modules ./node_modules

# Copy api's own node_modules on top (resolves pnpm symlinks)
COPY --from=builder /app/services/api/node_modules ./node_modules

# Create symlinks so pnpm's relative symlinks resolve correctly
# (pnpm uses paths like ../../../../node_modules/.pnpm/... and ../../../../packages/shared)
RUN ln -s /app/node_modules /node_modules && ln -s /app/packages /packages

# Generate Prisma client
RUN npx prisma generate

# Install tsx for TypeScript runtime support
RUN npm install -g tsx

EXPOSE 4000

CMD ["tsx", "dist/main.js"]