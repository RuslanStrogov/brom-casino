# ===== Server =====
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brom_casino?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===== Game Providers =====
# Pragmatic Play
PRAGMATIC_PLAY_API_URL=https://api.pragmaticplay.net
PRAGMATIC_PLAY_API_KEY=
PRAGMATIC_PLAY_CASINO_NAME=
PRAGMATIC_PLAY_SECRET_KEY=

# ===== Payment Providers =====
# Cryptomus
CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=

# ===== Game Engine =====
GAME_ENGINE_HOUSE_EDGE=0.04
GAME_ENGINE_MAX_PAYOUT_MULTIPLIER=10000

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ===== Bonus Defaults =====
DEFAULT_WAGERING_REQUIREMENT=35
WELCOME_BONUS_AMOUNT=100
WELCOME_BONUS_MATCH_PERCENT=100
WELCOME_BONUS_MAX=500

# ===== KYC =====
KYC_REQUIRED_FOR_WITHDRAWAL=true
KYC_REQUIRED_AMOUNT=1000

# ===== Admin =====
ADMIN_EMAIL=admin@brom.casino
